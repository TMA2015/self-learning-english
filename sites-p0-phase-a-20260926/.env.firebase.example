# Firebase Web config is public-by-design when restricted to Firebase APIs.
# Do NOT add a Gemini Developer API key here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=

# Choose a currently supported/free-tier Gemini model during Firebase setup.
# Do not hard-code the model in application source.
NEXT_PUBLIC_GEMINI_MODEL=
