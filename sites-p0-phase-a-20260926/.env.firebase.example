# Firebase Web config and App Check site keys are public browser configuration.
# Defaults for Self-Learning-English are in infrastructure/browser/firebase-public-config.ts.
# Use these only as overrides for another Firebase Web App/project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
NEXT_PUBLIC_GEMINI_MODEL=gemini-3.8-flash

# Local development only. When 1 on localhost, Firebase prints an App Check debug
# token that must be registered in Firebase Console. Never commit the token itself.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=0
