  "objectives": [
    {
      "id": "identify-topic-task-scope",
      "description": "Identify the topic, required response and scope of a Writing question.",
      "cefrTarget": "A2",
      "subskillTags": [
        "task-understanding"
      ],
      "prerequisiteSkills": []
    },
    {
      "id": "develop-relevant-reason",
      "description": "Support a relevant opinion with a reason and a concrete example.",
      "cefrTarget": "A2",
      "subskillTags": [
        "idea-development",
        "organization"
      ],
      "prerequisiteSkills": [
        "task-understanding"
      ]
    }
  ],
  "exercises": [
    {
      "id": "garden-relevant-idea",
      "type": "multiple-choice",
      "prompt": "Which idea answers the garden question?",
      "objectiveIds": [
        "identify-topic-task-scope"
      ],
      "subskillTags": [
        "task-understanding"
      ],
      "cefrTarget": "A2",
      "prerequisiteSkills": [],
      "options": [
        {
          "id": "a",
          "text": "My favorite food is pizza."
        },
        {
          "id": "b",
          "text": "Students can learn how plants grow."
        }
      ],
      "answer": {
        "correctOptionId": "b",
        "explanation": "This idea is about learning in the school garden and answers the question. The pizza idea is off topic."
      },
      "evidence": {
        "skill": "Writing",
        "tag": "task-understanding",
        "maxScore": 1,
        "method": "deterministic",
        "minimumObservations": 3,
        "setsCEFRDirectly": false
      }
    },
    {
      "id": "school-garden-writing",
      "type": "writing",
      "prompt": "Some students think schools should have a small garden. Do you agree? Give reasons and an example.",
      "objectiveIds": [
        "identify-topic-task-scope",
        "develop-relevant-reason"
      ],
      "subskillTags": [
        "task-understanding",
        "idea-development",
        "organization",
        "grammar-accuracy",
        "vocabulary",
        "sentence-quality"
      ],
      "cefrTarget": "A2",
      "prerequisiteSkills": [
        "task-understanding"
      ],
      "answer": {
        "rubricId": "writing-foundation-v1",
        "explanation": "Give your opinion, explain a relevant reason and include a concrete example. There is no single model answer; review the submitted language with the rubric."
      },
      "evidence": {
        "skill": "Writing",
        "tag": "idea-development",
        "maxScore": 10,
        "method": "review-required",
        "minimumObservations": 2,
        "setsCEFRDirectly": false
      }
    }
  ],
  "rubrics": {
    "writing-foundation-v1": {
      "version": "1.0",
      "criteria": [
        "task-understanding",
        "idea-development",
        "organization",
        "grammar-accuracy",
        "vocabulary",
        "sentence-quality"
      ],
      "scale": {
        "0": "No evidence",
        "2": "Isolated words",
        "4": "Simple communication with frequent errors",
        "6": "Mostly clear simple connected writing with some errors",
        "8": "Developed clear writing with mostly accurate sentences and varied language",
        "10": "Consistently effective at the B2 screen ceiling"
      },
      "withoutAI": "Provisional – AI language evaluation unavailable",
      "lengthDeterminesLevel": false
    }
